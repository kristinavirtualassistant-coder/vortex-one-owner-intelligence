# ==============================================================================
# Vortex One Owner Intelligence Platform — Environment Configuration
# ==============================================================================

# PostgreSQL / PostGIS Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vortex_one
DATABASE_SSL=false
DATABASE_STRICT_MODE=false
DATABASE_CONNECT_TIMEOUT_MS=2000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_POOL_MAX=20

# Google Gemini Intelligence Assistant (Server-Side Only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Maps Platform API Key (Used for map visualizations and address services)
GOOGLE_MAPS_API_KEY=

# Application Environment
NODE_ENV=production
